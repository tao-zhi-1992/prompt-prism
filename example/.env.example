# Prompt Prism Base URL; Demo appends /v1/messages internally.
DEMO_BASE_URL=http://127.0.0.1:8787

# Provider credential forwarded by the Demo Agent through Prompt Prism.
DEMO_MODEL_PROVIDER_TOKEN=replace-with-your-token

# Replace this placeholder with a model supported by your configured service.
DEMO_AGENT_MODEL=your-model-name

# Optional local port for the Demo Agent chat UI.
DEMO_PORT=3000
