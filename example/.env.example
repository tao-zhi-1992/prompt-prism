# Prompt Prism origin or the generated Proxy URL from `p2 url <provider-base-url>`.
# When Prism has no fixed upstream, paste the generated Proxy URL here.
DEMO_BASE_URL=http://127.0.0.1:1028

# Optional override: auto uses the protocol reported by Prism; set this explicitly
# when the generated Proxy URL targets an OpenAI Chat Completions provider.
DEMO_API_FORMAT=auto

# Provider credential forwarded by the Demo Agent through Prompt Prism.
DEMO_MODEL_PROVIDER_TOKEN=replace-with-your-token

# Replace this placeholder with a model supported by your configured service.
DEMO_AGENT_MODEL=your-model-name

# Optional local port for the Demo Agent chat UI.
DEMO_PORT=3000
