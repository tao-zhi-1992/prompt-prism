{
  "name": "prompt-prism",
  "version": "0.2.0",
  "description": "A transparent local proxy that explains prompt-cache misses.",
  "type": "module",
  "bin": {
    "p2": "bin/pp.js",
    "prompt-prism": "bin/pp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build:core": "node scripts/clean-build.js && tsc -p tsconfig.build.json",
    "build:plugins": "pnpm --dir ../plugins build:server",
    "build": "pnpm build:core && pnpm build:plugins",
    "typecheck": "pnpm build && tsc -p tsconfig.json",
    "build:all": "pnpm --dir ../plugins typecheck && pnpm build && pnpm --dir ../dashboard build",
    "prepare": "pnpm build:all",
    "prestart": "pnpm build:all",
    "pretest": "pnpm build:all",
    "start": "node bin/pp.js start --no-open --upstream-base-url https://api.deepseek.com --api-format anthropic",
    "test": "pnpm typecheck && tsx --test test/unit/*.test.ts test/integration/*.test.ts test/live/*.test.ts",
    "test:unit": "pnpm typecheck && tsx --test test/unit/*.test.ts",
    "test:integration": "pnpm build:all && pnpm typecheck && tsx --test test/integration/*.test.ts",
    "pretest:coverage": "pnpm build:all",
    "test:coverage": "c8 --clean --all --include='src/**/*.ts' --exclude='src/**/*.test.ts' --exclude='src/**/test/**' --exclude='src/cli.ts' --exclude='src/index.ts' --exclude='src/insights-cli.ts' --exclude='src/types.ts' --exclude='src/adapter/provider.ts' --reporter=text --reporter=json --reporter=html --report-dir=coverage --check-coverage --statements=90 --branches=75 --functions=90 --lines=90 tsx --test test/unit/*.test.ts test/integration/*.test.ts",
    "test:live": "pnpm build:all && pnpm typecheck && node --env-file-if-exists=.env --import tsx --test test/live/*.test.ts",
    "prepack": "pnpm build:all && node scripts/prepare-package.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "anthropic",
    "openai",
    "prompt-cache",
    "proxy",
    "debugging",
    "sse"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tao-zhi-1992/prompt-prism.git"
  },
  "homepage": "https://tao-zhi-1992.github.io/prompt-prism/",
  "bugs": {
    "url": "https://github.com/tao-zhi-1992/prompt-prism/issues"
  },
  "license": "MIT",
  "files": [
    "bin",
    "dist",
    "public",
    "assets",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@types/node": "^24.0.0",
    "c8": "^10.1.3",
    "openai": "^6.26.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
